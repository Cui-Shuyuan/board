{"id": "holdout-ark-final-card", "game": "ark-nova", "category": "new_holdout_explain", "question": "终局计分卡是在游戏结束后按什么规则结算？", "question_type": "positive", "expected_behavior": "answer_from_rule", "relation_hint": "explain", "expected_rule_ids": ["final_scoring_card"], "split": "new_holdout", "acceptable_rule_evidence": [{"rule_id": "final_scoring_card", "name": {"zh": "终局计分卡", "en": "Final Scoring Card"}, "description": "共 11 张的终局计分卡。开局每位玩家抽 2 张保密持有；首个玩家达到或超过 10 保护分时（或无人达到时于终局计分前）所有玩家各弃 1 张。终局时每张剩余卡用表格或文字表示如何获得 1-4 点额外保护分（计入终局分数）。单张卡获得的保护分最多 4 点。"}]}
{"id": "holdout-civ-slot-point-bonus", "game": "civolution", "category": "new_holdout_slot", "question": "终局分区的 point bonus 槽位具体怎么加总得分？", "question_type": "positive", "expected_behavior": "answer_from_rule", "relation_hint": "explain", "expected_rule_ids": ["final_scoring_area_hex.point_bonus"], "split": "new_holdout", "acceptable_rule_evidence": [{"rule_id": "final_scoring_area_hex.point_bonus", "name": "终局计分区的分数奖励槽", "description": "当阶段指示物位于终局计分区的 point bonus 格时，加总所有已安装的、包含分数奖励的研究牌所标示的分数奖励，并把总分推进得分轨。"}]}
{"id": "holdout-seasons-transmute", "game": "seasons", "category": "new_holdout_explain", "question": "能量储备通过转化表可以转换成什么？", "question_type": "positive", "expected_behavior": "answer_from_rule", "relation_hint": "explain", "expected_rule_ids": ["transmutation_chart"], "split": "new_holdout", "acceptable_rule_evidence": [{"rule_id": "transmutation_chart", "name": {"zh": "能量转化表", "en": "Energy Transmutation Chart"}, "description": "游戏版图上的转化表，按季节显示每种能量可转化为多少水晶：外圈能量=1 水晶、中圈=2 水晶、内圈=3 水晶。玩家回合内若拥有转化骰面（或卡牌赋予转化），可按当前季节的汇率把储备中的能量换为水晶，转化后的能量弃回供应堆。"}]}
{"id": "holdout-wingspan-player-hand", "game": "wingspan", "category": "new_holdout_setup", "question": "开局时每位玩家先拿几张鸟牌？", "question_type": "positive", "expected_behavior": "answer_from_rule", "relation_hint": "explain", "expected_rule_ids": ["player_setup"], "split": "new_holdout", "acceptable_rule_evidence": [{"rule_id": "player_setup", "name": {"zh": "玩家设置", "en": "Player Setup"}, "description": "每位玩家获得玩家板、8 个行动方块、5 张随机鸟牌、2 张奖励牌、5 个食物（每种 1 个）；保留最多 5 张鸟牌（每保留 1 张弃 1 个食物），保留 1 张奖励牌；然后随机决定先手玩家。"}]}
