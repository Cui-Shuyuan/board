{"id": "holdout-wingspan-multi", "game": "wingspan", "category": "new_holdout_multi", "question": "开局每人先发几张鸟牌，之后回合里行动方块怎么用？", "question_type": "positive", "expected_behavior": "answer_from_rule", "relation_hint": "explain", "expected_rule_ids": ["player_setup", "action_cube"], "split": "new_holdout", "acceptable_rule_evidence": [{"rule_id": "player_setup", "name": {"zh": "玩家设置", "en": "Player Setup"}, "description": "每位玩家获得玩家板、8 个行动方块、5 张随机鸟牌、2 张奖励牌、5 个食物（每种 1 个）；保留最多 5 张鸟牌（每保留 1 张弃 1 个食物），保留 1 张奖励牌；然后随机决定先手玩家。"}, {"rule_id": "action_cube", "name": {"zh": "行动方块", "en": "Action Cube"}, "description": "每位玩家 8 个同色木块。每回合可用行动数递减：第 1–4 回合分别为 8/7/6/5 个。行动时放在玩家板对应行动行最左侧未使用的格，回合末移除。"}]}
{"id": "holdout-splendor-multi-noble", "game": "splendor", "category": "new_holdout_multi", "question": "贵族板块设置时怎么发，回合结束又怎么获得？", "question_type": "positive", "expected_behavior": "answer_from_rule", "relation_hint": "explain", "expected_rule_ids": ["deal_nobles", "attract_noble"], "split": "new_holdout", "acceptable_rule_evidence": [{"rule_id": "deal_nobles", "name": {"zh": "发放贵族板块", "en": "Deal Nobles"}, "description": "从游戏盒中随机盲抽 player_count + 1 枚贵族板块，放入贵族市场。"}, {"rule_id": "attract_noble", "name": {"zh": "贵族来访", "en": "Attract Noble"}, "description": "璀璨宝石中的「贵族来访」<ontology::trigger>。当一名<ontology::player>的回合结束时，若其<ontology::development_area>中各色<development_card>的数量满足了<noble_market>中某枚<noble>的 requirement，该<noble>自动来访——移入该<ontology::player>的<ontology::development_area>并提供 3 点<prestige_point>。玩家不能拒绝贵族来访；若同时有多枚<noble>满足条件，由该<ontology::player>选择其中一枚，每回合至多获得一枚<noble>。与<card_market>的主动购买不同，<noble>不可购买，只能通过本<ontology::trigger>获得。"}]}
{"id": "holdout-agricola-multi-occupation", "game": "agricola", "category": "new_holdout_multi", "question": "职业卡开局怎么发，什么时候可以打出来？", "question_type": "positive", "expected_behavior": "answer_from_rule", "relation_hint": "explain", "expected_rule_ids": ["filter_and_deal_occupations", "play_occupation"], "split": "new_holdout", "acceptable_rule_evidence": [{"rule_id": "filter_and_deal_occupations", "name": {"zh": "筛选并发放职业卡", "en": "Filter and Deal Occupations"}, "description": "先按人数筛选<occupation_card>（左侧方块符号：[1+] 用于 1-4 人、[3+] 用于 3-4 人、[4] 仅 4 人局——不用的放回盒中），把剩下的洗混，每位玩家从牌堆顶抽 7 张入<hand>。"}, {"rule_id": "play_occupation", "name": {"zh": "打出职业", "en": "Play Occupation"}, "description": "「学习」行动格（<space_lessons>/<space_lessons_3p>/<space_lessons_4p>）提供的行动：从<hand>打出恰好 1 张<occupation_card>，正面朝上放<played_cards_area>，文字立即生效（优先于规则书）。职业费用（「职业费用」）：<space_lessons>上第一张免费、之后每张 1 <food>；3 人局<space_lessons_3p>每张 2 <food>；4 人局<space_lessons_4p>前两张各 1 <food>、之后每张 2 <food>。职业数量不受家庭成员数限制。个别职业另有费用/条件（卡面为准）。"}]}
