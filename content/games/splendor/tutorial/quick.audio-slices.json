            "end_ref": "quick_setup_players__001.subtitle.0.end",
            "text": "随机抽出玩家人数加一块贵族，正面朝上放在旁边；"
          }
        ]
      }
    ],
    "quick_setup_players/002": [
      {
        "id": "quick_setup_players__002",
        "asset": "media/tts/quick.cues/quick_setup_players__002.b1.mp3",
        "start_ref": "quick_setup_players__002.start",
