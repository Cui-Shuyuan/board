          }
        ]
      }
    ],
    "quick_intro/001": [
      {
        "id": "quick_intro__001",
        "asset": "media/tts/quick.cues/quick_intro__001.b1.mp3",
        "start_ref": "quick_intro__001.start",
        "end_ref": "quick_intro__001.end",
        "speech_end_ref": "quick_intro__001.speech_end",
        "subtitles": [
          {
            "start_ref": "quick_intro__001.subtitle.0.start",
            "end_ref": "quick_intro__001.subtitle.0.end",
            "text": "璀璨宝石的目标，是成为最负盛名的商人。"
          },
          {
            "start_ref": "quick_intro__001.subtitle.1.start",
            "end_ref": "quick_intro__001.subtitle.1.end",
            "text": "所有玩家轮流行动，达到15分并完成最后一轮后，分数最高者获胜。"
          }
        ]
      }
    ],
    "quick_setup_cards/title_2": [
      {
        "id": "quick_setup_cards__title_2",
        "asset": "media/tts/quick.cues/quick_setup_cards__title_2.b1.mp3",
        "start_ref": "quick_setup_cards__title_2.start",
        "end_ref": "quick_setup_cards__title_2.end",
        "speech_end_ref": "quick_setup_cards__title_2.speech_end",
        "subtitles": [
          {
            "start_ref": "quick_setup_cards__title_2.subtitle.0.start",
            "end_ref": "quick_setup_cards__title_2.subtitle.0.end",
            "text": "2，设置。"
          }
        ]
      }
    ],
    "quick_setup_cards/001.1": [
      {
        "id": "quick_setup_cards__001.1",
        "asset": "media/tts/quick.cues/quick_setup_cards__001.1.b1.mp3",
        "start_ref": "quick_setup_cards__001.1.start",
        "end_ref": "quick_setup_cards__001.1.end",
        "speech_end_ref": "quick_setup_cards__001.1.speech_end",
        "subtitles": [
          {
            "start_ref": "quick_setup_cards__001.1.subtitle.0.start",
            "end_ref": "quick_setup_cards__001.1.subtitle.0.end",
            "text": "发展卡共90张，按背面分成三级：一级、二级、三级。"
          }
        ]
      }
    ],
    "quick_setup_cards/001.2": [
      {
        "id": "quick_setup_cards__001.2",
        "asset": "media/tts/quick.cues/quick_setup_cards__001.2.b1.mp3",
        "start_ref": "quick_setup_cards__001.2.start",
        "end_ref": "quick_setup_cards__001.2.end",
        "speech_end_ref": "quick_setup_cards__001.2.speech_end",
        "subtitles": [
          {
            "start_ref": "quick_setup_cards__001.2.subtitle.0.start",
            "end_ref": "quick_setup_cards__001.2.subtitle.0.end",
            "text": "每级洗混后，翻开四张，摆成三行，组成市场。"
          }
        ]
      }
    ],
    "quick_setup_gems/002": [
      {
        "id": "quick_setup_gems__002",
        "asset": "media/tts/quick.cues/quick_setup_gems__002.b1.mp3",
        "start_ref": "quick_setup_gems__002.start",
        "end_ref": "quick_setup_gems__002.end",
        "speech_end_ref": "quick_setup_gems__002.speech_end",
        "subtitles": [
          {
            "start_ref": "quick_setup_gems__002.subtitle.0.start",
            "end_ref": "quick_setup_gems__002.subtitle.0.end",
            "text": "再按人数摆宝石：两人每种四枚，三人每种五枚，四人每种七枚；"
          },
          {
            "start_ref": "quick_setup_gems__002.subtitle.1.start",
            "end_ref": "quick_setup_gems__002.subtitle.1.end",
            "text": "黄金的数量和人数无关，放置五枚。"
          }
        ]
      }
    ],
    "quick_setup_players/001": [
      {
        "id": "quick_setup_players__001",
        "asset": "media/tts/quick.cues/quick_setup_players__001.b1.mp3",
        "start_ref": "quick_setup_players__001.start",
        "end_ref": "quick_setup_players__001.end",
        "speech_end_ref": "quick_setup_players__001.speech_end",
