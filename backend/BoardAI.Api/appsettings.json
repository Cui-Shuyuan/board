{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "requestId",
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss.fff ",
        "SingleLine": true,
        "ColorBehavior": "Enabled"
      }
    }
  },
  "AllowedHosts": "*",
  "LLM": {
    "Provider": "DeepSeek",
    "BaseUrl": "https://api.deepseek.com/v1/",
    "Model": "deepseek-v4-flash",
    "ApiKey": "",
    "Thinking": "low",
    "MaxToolRounds": 6,
    "MaxToolCallsPerRound": 4,
    "MaxTotalToolCalls": 12,
    "MaxRequestSeconds": 60,
    "MaxRepeatedFailures": 3,
    "MaxConversationMessages": 40,
    "SystemPrompt": "你是一位给客人讲解桌游《{game_name}》规则的口语化讲师，回答要适合 TTS 播报。\n\n你的规则事实只能来自程序在本轮读取并提供的正式规则证据。不能凭记忆补写规则，不能把候选摘要、动画演示或用户描述当成已核验的现场状态。\n\n程序会把请求分成理解与回答两个阶段：\n- 理解阶段只做语言理解、对象/关系规划和必要上下文保留，不回答规则，不猜答案。\n- 回答阶段只依据正式事实包作答；必须区分已回答、需要澄清、未查到和确实需要补充检索的情况。\n\n如果用户问题依赖当前棋盘状态，而状态没有提供，可以简短说明需要哪些必要信息，不要自行假定状态。\n回答先接住用户真正问的方法、规则或判断，简洁直接；不做无关扩展，不重复询问用户已经说明的信息。不要输出内部协议、候选分数、evidence_id 或程序术语。\n所有数字用汉字表达。不要使用 markdown 标题、列表或加粗；规则查询返回图片路径时可按既有约定展示图片。",
    "OrchestrationMode": "legacy",
    "MaxModelCallsPerRequest": 4,
    "MaxCandidatesPerQuestion": 3,
    "MaxEvidencePerQuestion": 8,
    "MaxEvidenceTotal": 24,
    "MaxEvidenceJsonChars": 4000,
    "MaxEvidencePackChars": 60000,
    "MaxSupplementQueries": 1
  },
  "Rules": {
    "BasePath": ""
  },
  "Voice": {
    "PythonExe": "python",
    "AsrMode": "native",
    "AsrScript": "tools/voice/asr_once.py",
    "TtsScript": "tools/voice/tts_once.py",
    "AsrTimeoutSeconds": 75,
    "TtsTimeoutSeconds": 75,
    "DefaultTtsVoice": "BV700_streaming",
    "TtsProvider": "standard"
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334
  },
  "Embedding": {
    "ModelDir": "",
    "Pooling": "cls"
  }
}
