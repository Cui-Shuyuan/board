  "modules": [
    {
      "id": "module_migration",
      "instance_of": "<upgradable_module>",
      "name": { "zh": "迁徙", "en": "Migration" },
      "abstract": false,
      "module_type": "main",
      "tile": "<tile_migration>",
      "<ontology::cost>": {
        "<ontology::instant_cost>": {
          "options": [
            {
              "<ontology::transfer>": {
                "source": "<activation_dice_area>",
                "destination": "<ontology::supply>",
                "<object>": { "<activation_die>": { "value": 1 } },
                "description": {
                  "zh": "支付 1 个点数 1 的<activation_die>。",
                  "en": "Pay 1 <activation_die> showing value 1."
                }
              }
            },
            {
              "<ontology::transfer>": {
                "source": "<activation_dice_area>",
                "destination": "<ontology::supply>",
                "<object>": { "<activation_die>": { "value": 3 } },
                "description": {
                  "zh": "支付 1 个点数 3 的<activation_die>。",
                  "en": "Pay 1 <activation_die> showing value 3."
                }
              }
            }
          ],
          "type": "<ontology::multiple_choice_enum.EXECUTE_ALL>"
        }
      },
      "level_effects": [
        {
          "level": 1,
          "description": {
            "zh": "执行 1 次迁徙。",
            "en": "Perform 1 migration."
          },
          "<ontology::instant_effect>": {
            "<ontology::cost>": "this.<ontology::cost>",
            "<ontology::content>": {
              "<ontology::instant_content>": "<migrate>"
            }
          }
        },
        {
          "level": 2,
          "description": {
            "zh": "先过 1 次恩惠检定：通过则最多迁徙 2 次，未通过则迁徙 1 次。",
            "en": "Take a favor test first: if it passes, perform up to 2 migrations; if not, perform 1 migration."
          },
          "<ontology::instant_effect>": {
            "<ontology::cost>": "this.<ontology::cost>",
            "<ontology::content>": {
              "<ontology::instant_content>": {
                "options": [
                  "<favor_test>",
                  {
                    "<ontology::action>": {
                      "do_after": [
                        "<favor_test>"
                      ],
                      "<ontology::condition>": {
                        "zh": "<favor_test>.result == pass",
                        "en": "<favor_test>.result == pass"
                      },
                      "<ontology::content>": {
                        "<ontology::instant_content>": {
                          "<migrate>": {
                            "quantity": "<=2"
                          }
                        }
                      }
                    }
                  },
                  {
                    "<ontology::action>": {
                      "do_after": [
                        "<favor_test>"
                      ],
                      "<ontology::condition>": {
                        "zh": "<favor_test>.result == fail",
                        "en": "<favor_test>.result == fail"
                      },
                      "<ontology::content>": {
                        "<ontology::instant_content>": "<migrate>"
                      }
                    }
                  }
                ],
                "type": "<ontology::multiple_choice_enum.EXECUTE_ALL>"
              }
            }
          }
        },
        {
          "level": 3,
          "description": {
            "zh": "先过 1 次恩惠检定：通过则最多迁徙 3 次，未通过则最多迁徙 2 次。同一部落多次迁徙时，仅最终落定的领地生效，其余领地只是穿越（不进入营地、不获得火营地分、不开发领地）。",
            "en": "Take a favor test first: if it passes, perform up to 3 migrations; if not, up to 2 migrations. When the same tribe migrates multiple times, only the final territory is settled; the others are merely crossed through (no encampment entry, no fire encampment points, no territory development)."
          },
          "<ontology::instant_effect>": {
            "<ontology::cost>": "this.<ontology::cost>",
            "<ontology::content>": {
              "<ontology::instant_content>": {
                "options": [
                  "<favor_test>",
                  {
                    "<ontology::action>": {
                      "do_after": [
                        "<favor_test>"
                      ],
                      "<ontology::condition>": {
                        "zh": "<favor_test>.result == pass",
                        "en": "<favor_test>.result == pass"
                      },
                      "<ontology::content>": {
                        "<ontology::instant_content>": {
                          "<migrate>": {
                            "quantity": "<=3"
                          }
                        }
                      }
                    }
                  },
                  {
                    "<ontology::action>": {
                      "do_after": [
                        "<favor_test>"
                      ],
                      "<ontology::condition>": {
                        "zh": "<favor_test>.result == fail",
                        "en": "<favor_test>.result == fail"
                      },
                      "<ontology::content>": {
                        "<ontology::instant_content>": {
                          "<migrate>": {
                            "quantity": "<=2"
                          }
                        }
                      }
                    }
                  }
                ],
                "type": "<ontology::multiple_choice_enum.EXECUTE_ALL>"
              }
            }
          }
        }
      ]
    },
