      "<ontology::cost>": {
        "<ontology::instant_cost>": {
          "options": [
            {
              "<ontology::transfer>": {
                "source": "<activation_dice_area>",
                "destination": "<ontology::supply>",
                "<object>": { "<activation_die>": { "value": 1 } },
                "description": {
                  "zh": "支付 1 个点数 1 的<activation_die>。",
                  "en": "Pay 1 <activation_die> showing value 1."
                }
              }
            },
            {
              "<ontology::transfer>": {
                "source": "<activation_dice_area>",
                "destination": "<ontology::supply>",
                "<object>": { "<activation_die>": { "value": 2 } },
                "description": {
                  "zh": "支付 1 个点数 2 的<activation_die>。",
                  "en": "Pay 1 <activation_die> showing value 2."
                }
              }
            }
          ],
          "type": "<ontology::multiple_choice_enum.EXECUTE_ALL>"
        }
      },
      "level_effects": [
        {
          "level": 1,
          "description": {
            "zh": "从明面研究牌堆拿 1 张研究牌，或抽 2 张选 1 张。",
            "en": "Take 1 research card from the face-up stacks, or draw 2 and keep 1."
          },
          "<ontology::instant_effect>": {
            "<ontology::cost>": "this.<ontology::cost>",
            "<ontology::content>": {
              "<ontology::instant_content>": {
                "options": [
                  "<gain_research_card>",
                  {
                    "description": {
                      "zh": "抽 2 张<research_card>，选 1 张加入手牌，另 1 张放回牌堆底。详见<draw_pick_return_research>（N=2, K=1）。",
                      "en": "Draw 2 <research_card>s, keep 1, return 1 to bottom. See <draw_pick_return_research> (N=2, K=1)."
                    }
                  }
                ],
                "type": "<ontology::multiple_choice_enum.CHOOSE_ONE>"
              }
            }
          }
        },
        {
          "level": 2,
          "description": {
            "zh": "从明面研究牌堆拿 1 张研究牌，或抽 4 张选 1 张。",
            "en": "Take 1 research card from the face-up stacks, or draw 4 and keep 1."
          },
          "<ontology::instant_effect>": {
            "<ontology::cost>": "this.<ontology::cost>",
            "<ontology::content>": {
              "<ontology::instant_content>": {
                "options": [
                  "<gain_research_card>",
                  {
                    "description": {
                      "zh": "抽 4 张<research_card>，选 1 张加入手牌，另 3 张放回牌堆底。详见<draw_pick_return_research>（N=4, K=1）。",
                      "en": "Draw 4 <research_card>s, keep 1, return 3 to bottom. See <draw_pick_return_research> (N=4, K=1)."
                    }
                  }
                ],
                "type": "<ontology::multiple_choice_enum.CHOOSE_ONE>"
              }
            }
          }
        },
        {
          "level": 3,
          "description": {
            "zh": "执行 2 次拿研究牌，或抽 4 张选 2 张。",
            "en": "Take research cards twice, or draw 4 and keep 2."
          },
          "<ontology::instant_effect>": {
            "<ontology::cost>": "this.<ontology::cost>",
            "<ontology::content>": {
              "<ontology::instant_content>": {
                "options": [
                  {
                    "description": {
                      "zh": "执行 2 次<gain_research_card>。",
                      "en": "Perform <gain_research_card> twice."
                    }
                  },
                  {
                    "description": {
                      "zh": "抽 4 张<research_card>，选 2 张加入手牌，另 2 张放回牌堆底。详见<draw_pick_return_research>（N=4, K=2）。",
                      "en": "Draw 4 <research_card>s, keep 2, return 2 to bottom. See <draw_pick_return_research> (N=4, K=2)."
                    }
                  }
                ],
                "type": "<ontology::multiple_choice_enum.CHOOSE_ONE>"
              }
            }
          }
        }
      ]
    },
