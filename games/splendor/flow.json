{
  "meta": {
    "name": {
      "zh": "璀璨宝石",
      "en": "Splendor"
    },
    "description": {
      "zh": "璀璨宝石的流程定义——一局游戏从 Setup 到终局判胜的完整流程。与 concepts.json 配合：concepts.json 定义「有什么」（对象、行动、触发器、条件），本文档定义「按什么顺序进行」（Setup、回合结构、终局流程）。Setup 阶段使用 do_after 表达事件间的依赖关系：无 do_after 的事件互相独立，可任意顺序或并行执行；do_after 引用的事件必须先完成。",
      "en": "Flow definition for Splendor — the complete sequence of a game from setup to endgame adjudication. Complements concepts.json: concepts.json defines 'what exists' (objects, actions, triggers, conditions); this document defines 'in what order it happens' (setup, turn structure, endgame process). The setup phase uses do_after to express dependencies between events: events without do_after are independent and may execute in any order or in parallel; events listed in do_after must complete first."
    },
    "game": "splendor",
    "version": "0.1.0"
  },
  "procedures": [
    {
      "id": "game",
      "name": {
        "zh": "游戏",
        "en": "Game"
      },
      "specifies": "<ontology::round>",
      "description": {
        "zh": "整局璀璨宝石游戏，作为最外层轮。包含设置、主游戏流程与终局。",
        "en": "The whole game of Splendor as the outermost round: setup, main gameplay, and endgame."
      },
      "<ontology::pipeline>": {
        "options": [
          {
            "id": "setup",
            "name": {
              "zh": "设置",
              "en": "Setup"
            },
            "specifies": "<ontology::phase>",
            "description": {
              "zh": "游戏设置：准备三组发展卡牌堆并洗匀、向市场发牌、随机摆放贵族、按人数分发宝石与黄金、决定起始玩家。",
              "en": "Game setup: prepare and shuffle the three development decks, deal the market, place nobles at random, distribute gems and gold by player count, and determine the starting player."
            },
            "<ontology::pipeline>": {
              "options": [
                {
                  "id": "prepare_level_1_deck",
                  "name": {
                    "zh": "准备一级发展卡牌堆",
                    "en": "Prepare Level 1 Deck"
                  },
                  "specifies": "<ontology::transfer>",
                  "description": {
                    "zh": "将游戏盒中所有一级发展卡移至一级发展卡牌堆，使其成为一个<ontology::deck>。",
                    "en": "Move all level I development cards from the game box into the level I development deck, forming it into a <ontology::deck>."
                  },
                  "source": "<ontology::game_box>",
                  "destination": "<development_deck_level_1>",
                  "<object>": "<development_card_level_1>",
                  "quantity": "all"
                },
                {
                  "id": "prepare_level_2_deck",
                  "name": {
                    "zh": "准备二级发展卡牌堆",
                    "en": "Prepare Level 2 Deck"
                  },
                  "specifies": "<ontology::transfer>",
                  "description": {
                    "zh": "将游戏盒中所有二级发展卡移至二级发展卡牌堆，使其成为一个<ontology::deck>。",
                    "en": "Move all level II development cards from the game box into the level II development deck, forming it into a <ontology::deck>."
                  },
                  "source": "<ontology::game_box>",
                  "destination": "<development_deck_level_2>",
                  "<object>": "<development_card_level_2>",
                  "quantity": "all"
                },
                {
                  "id": "prepare_level_3_deck",
                  "name": {
                    "zh": "准备三级发展卡牌堆",
                    "en": "Prepare Level 3 Deck"
                  },
                  "specifies": "<ontology::transfer>",
                  "description": {
                    "zh": "将游戏盒中所有三级发展卡移至三级发展卡牌堆，使其成为一个<ontology::deck>。",
                    "en": "Move all level III development cards from the game box into the level III development deck, forming it into a <ontology::deck>."
                  },
                  "source": "<ontology::game_box>",
                  "destination": "<development_deck_level_3>",
                  "<object>": "<development_card_level_3>",
                  "quantity": "all"
                },
                {
                  "id": "shuffle_level_1_deck",
                  "name": {
                    "zh": "洗一级发展卡牌堆",
                    "en": "Shuffle Level 1 Deck"
                  },
                  "specifies": "<ontology::shuffle>",
                  "target": "<development_deck_level_1>",
                  "do_after": [
                    "prepare_level_1_deck"
                  ]
                },
                {
                  "id": "shuffle_level_2_deck",
                  "name": {
                    "zh": "洗二级发展卡牌堆",
                    "en": "Shuffle Level 2 Deck"
                  },
                  "specifies": "<ontology::shuffle>",
                  "target": "<development_deck_level_2>",
                  "do_after": [
                    "prepare_level_2_deck"
                  ]
                },
                {
                  "id": "shuffle_level_3_deck",
                  "name": {
                    "zh": "洗三级发展卡牌堆",
                    "en": "Shuffle Level 3 Deck"
                  },
                  "specifies": "<ontology::shuffle>",
                  "target": "<development_deck_level_3>",
                  "do_after": [
                    "prepare_level_3_deck"
                  ]
                },
                {
                  "id": "deal_card_market_level_1",
                  "name": {
                    "zh": "发一级发展卡市场",
                    "en": "Deal Level 1 Market"
                  },
                  "specifies": "<ontology::transfer>",
                  "source": "<development_deck_level_1>",
                  "destination": "<card_market>",
                  "<object>": "<development_card_level_1>",
                  "quantity": 4,
                  "slot": "level_1",
                  "do_after": [
                    "shuffle_level_1_deck"
                  ]
                },
                {
                  "id": "deal_card_market_level_2",
                  "name": {
                    "zh": "发二级发展卡市场",
                    "en": "Deal Level 2 Market"
                  },
                  "specifies": "<ontology::transfer>",
                  "source": "<development_deck_level_2>",
                  "destination": "<card_market>",
                  "<object>": "<development_card_level_2>",
                  "quantity": 4,
                  "slot": "level_2",
                  "do_after": [
                    "shuffle_level_2_deck"
                  ]
                },
                {
                  "id": "deal_card_market_level_3",
                  "name": {
                    "zh": "发三级发展卡市场",
                    "en": "Deal Level 3 Market"
                  },
                  "specifies": "<ontology::transfer>",
                  "source": "<development_deck_level_3>",
                  "destination": "<card_market>",
                  "<object>": "<development_card_level_3>",
                  "quantity": 4,
                  "slot": "level_3",
                  "do_after": [
                    "shuffle_level_3_deck"
                  ]
                },
                {
                  "id": "deal_nobles",
                  "name": {
                    "zh": "发放贵族板块",
                    "en": "Deal Nobles"
                  },
                  "specifies": "<ontology::random_draw>",
                  "description": {
                    "zh": "从游戏盒中随机盲抽 player_count + 1 枚贵族板块，放入贵族市场。",
                    "en": "Blindly draw player_count + 1 noble tiles from the game box and place them into the noble market."
                  },
                  "source": "<ontology::game_box>",
                  "destination": "<noble_market>",
                  "<object>": "<noble>",
                  "quantity": {
                    "expr": "player_count + 1"
                  }
                },
                {
                  "id": "distribute_gems",
                  "name": {
                    "zh": "分发宝石",
                    "en": "Distribute Gems"
                  },
                  "specifies": "<ontology::transfer>",
                  "source": "<ontology::game_box>",
                  "destination": "<gem_supply>",
                  "<object>": "<gem>",
                  "quantity_per_color": {
                    "2": {
                      "diamond": 4,
                      "sapphire": 4,
                      "emerald": 4,
                      "ruby": 4,
                      "onyx": 4
                    },
                    "3": {
                      "diamond": 5,
                      "sapphire": 5,
                      "emerald": 5,
                      "ruby": 5,
                      "onyx": 5
                    },
                    "4": {
                      "diamond": 7,
                      "sapphire": 7,
                      "emerald": 7,
                      "ruby": 7,
                      "onyx": 7
                    }
                  }
                },
                {
                  "id": "distribute_gold",
                  "name": {
                    "zh": "分发黄金",
                    "en": "Distribute Gold"
                  },
                  "specifies": "<ontology::transfer>",
                  "source": "<ontology::game_box>",
                  "destination": "<gold_supply>",
                  "<object>": "<gold>",
                  "quantity": 5
                },
                {
                  "id": "choose_starting_player",
                  "name": {
                    "zh": "选择起始玩家",
                    "en": "Choose Starting Player"
                  },
                  "specifies": "<ontology::state_change>",
                  "subject": "<ontology::starting_player>",
                  "to": "随机选中的玩家",
                  "rules": {
                    "zh": "随机选择一名玩家，将<ontology::starting_player>状态设为该玩家。",
                    "en": "Randomly choose one player and set <ontology::starting_player> to that player."
                  }
                },
                {
                  "id": "give_starting_player_marker",
                  "name": {
                    "zh": "给予起始玩家标记",
                    "en": "Give Starting Player Marker"
                  },
                  "specifies": "<ontology::transfer>",
                  "source": "<ontology::game_box>",
                  "destination": "起始玩家",
                  "<ontology::object>": "<ontology::starting_player_marker>",
                  "quantity": 1,
                  "do_after": [
                    "choose_starting_player"
                  ]
                }
              ],
              "type": "<ontology::multiple_choice_enum.EXECUTE_ALL>"
            }
          },
          {
            "id": "main_gameplay",
            "name": {
              "zh": "主游戏流程",
              "en": "Main Gameplay"
            },
            "specifies": "<ontology::phase>",
            "description": {
              "zh": "主游戏流程：重复轮换回合，每位玩家依次行动（取宝石、购买或保留发展卡），直到任意玩家声望达到 15 分触发终局。",
              "en": "Main gameplay: rounds of turns repeat, each player acting in order (taking gems, purchasing, or reserving a development card), until any player reaches 15 prestige points and triggers the endgame."
            },
            "do_after": [
              "setup"
            ],
            "loop": {
              "until": "<reach_15_prestige>"
            },
            "<ontology::round>": {
              "id": "turn_cycle",
              "name": {
                "zh": "回合轮",
                "en": "Turn Cycle"
              },
              "description": {
                "zh": "一轮玩家回合：每位玩家一个回合。",
                "en": "One cycle of player turns: one turn per player."
              },
              "<ontology::turn>": {
                "id": "player_turn",
                "name": {
                  "zh": "玩家回合",
                  "en": "Player Turn"
                },
                "description": {
                  "zh": "一位玩家的回合：选择并执行一个合法行动（取不同宝石、取同色宝石、购买发展卡或保留发展卡）。",
                  "en": "One player's turn: choose and execute one legal action (take different gems, take two gems of the same color, purchase a development card, or reserve a development card)."
                },
                "<ontology::action>": {
                  "options": [
                    "<take_gems_different>",
                    "<take_gems_same>",
                    "<purchase_development_card>",
                    "<reserve_development_card>",
                    "<skip_turn>"
                  ],
                  "type": "<ontology::multiple_choice_enum.CHOOSE_ONE>"
                }
              }
            }
          },
          {
            "id": "endgame",
            "name": {
              "zh": "终局",
              "en": "Endgame"
            },
            "specifies": "<ontology::phase>",
            "description": {
              "zh": "终局阶段：15 分触发的当前轮已在<main_gameplay>内完整跑完（loop 在轮末检查——触发后剩余玩家照常行动）。本阶段直接判定胜者。",
              "en": "Endgame phase: the round in which 15 points was reached has already completed in full within <main_gameplay> (the loop checks at the end of each round — after the trigger, the remaining players keep acting normally). This phase directly adjudicates the winner."
            },
            "do_after": [
              "main_gameplay"
            ],
            "<ontology::evaluate>": {
              "id": "adjudicate_victory",
              "name": {
                "zh": "判定胜者",
                "en": "Adjudicate Victory"
              },
              "specifies": "<ontology::evaluate>",
              "description": {
                "zh": "判定胜者：声望最高者获胜；平局时比较发展卡数量，更少者胜。",
                "en": "Adjudicate the winner: highest prestige wins; ties are broken by fewer development cards."
              },
              "result": {
                "zh": "胜者玩家。",
                "en": "The winning player."
              },
              "rules": {
                "zh": "按<highest_prestige_wins>判定胜者：先比较<prestige_point>总数，并列者再比较<ontology::development_area>中<development_card>数量。",
                "en": "Adjudicate by <highest_prestige_wins>: highest total <prestige_point>s, then fewest <development_card>s in <ontology::development_area>."
              }
            }
          }
        ],
        "type": "<ontology::multiple_choice_enum.EXECUTE_ALL>"
      }
    },
    {
      "id": "purchase_development_card",
      "name": {
        "zh": "购买发展卡",
        "en": "Purchase Development Card"
      },
      "specifies": "<ontology::action>",
      "description": {
        "zh": "购买 1 张发展卡。玩家选择 1 张 <development_card>，支付费用，打出至 <development_area>，若从 <card_market> 购买则补牌。",
        "en": "Purchase 1 development card. Player selects 1 <development_card>, pays its cost, plays it into <development_area>, and refills from deck if bought from <card_market>."
      },
      "<ontology::content>": {
        "<ontology::instant_content>": {
          "options": [
            {
              "id": "pay_cost",
              "name": {
                "zh": "支付费用",
                "en": "Pay Cost"
              },
              "<ontology::transfer>": {
                "description": {
                  "zh": "支付费用：将各色 <gem> 从 <player_holding> 返回供应堆，数量 = card <cost> 减 <discount>，<gold> 百搭。",
                  "en": "Pay cost: return <gem>s from <player_holding> to supply. Quantity = card <cost> minus <discount>s, <gold> substitutes any color."
                },
                "source": "<ontology::player_holding>",
                "destination": "<gem_supply>",
                "<ontology::object>": "<gem>"
              }
            },
            {
              "id": "play_card",
              "name": {
                "zh": "打出卡牌",
                "en": "Play Card"
              },
              "do_after": [
                "pay_cost"
              ],
              "<ontology::play>": {
                "description": {
                  "zh": "打出卡牌：将目标 <development_card> 从 <card_market> 或 <hand> 移至 <development_area>。",
                  "en": "Play card: move the target <development_card> from <card_market> or <hand> to <development_area>."
                },
                "source": "<card_market>",
                "destination": "<ontology::development_area>",
                "<ontology::object>": "<development_card>"
              }
            },
            {
              "do_after": [
                "play_card"
              ],
              "<refill_market>": {
                "description": {
                  "zh": "若购买自 <card_market>，从对应 <development_deck> 顶部翻 1 张补入空位。来自 <hand> 则跳过。",
                  "en": "If purchased from <card_market>, reveal 1 card from the corresponding <development_deck> top into the empty slot. Skip if from <hand>."
                }
              }
            }
          ],
          "type": "<ontology::multiple_choice_enum.EXECUTE_ALL>"
        }
      }
    },
    {
      "id": "reserve_development_card",
      "name": {
        "zh": "保留发展卡",
        "en": "Reserve Development Card"
      },
      "specifies": "<ontology::action>",
      "description": {
        "zh": "保留 1 张发展卡。玩家将 1 张 <development_card> 移入 <hand>，同时从 <gold_supply> 拿取 1 个 <gold>（若有库存）。",
        "en": "Reserve 1 development card. Player moves 1 <development_card> into <hand> and takes 1 <gold> from <gold_supply> (if available)."
      },
      "<ontology::content>": {
        "<ontology::instant_content>": {
          "options": [
            {
              "id": "reserve_card",
              "name": {
                "zh": "保留卡牌",
                "en": "Reserve Card"
              },
              "options": [
                {
                  "id": "reserve_from_market",
                  "name": {
                    "zh": "明面保留",
                    "en": "Reserve Openly"
                  },
                  "<ontology::transfer>": {
                    "description": {
                      "zh": "明面保留：从 <card_market> 任选 1 张 <development_card> 移入 <hand>。",
                      "en": "Reserve openly: choose any 1 <development_card> from <card_market> and move it into <hand>."
                    },
                    "source": "<card_market>",
                    "destination": "<ontology::hand>",
                    "<ontology::object>": "<development_card>",
                    "quantity": 1
                  }
                },
                {
                  "id": "reserve_from_deck",
                  "name": {
                    "zh": "暗面保留",
                    "en": "Reserve Blindly"
                  },
                  "<ontology::top_draw>": {
                    "description": {
                      "zh": "暗面保留：从某一等级 <development_deck> 的顶部盲抽最上面 1 张 <development_card>（事先不知道是哪张）移入 <hand>。",
                      "en": "Reserve blindly: draw the top 1 <development_card> of a level's <development_deck> (sight unseen) and move it into <hand>."
                    },
                    "source": "<development_deck>",
                    "destination": "<ontology::hand>",
                    "<ontology::object>": "<development_card>",
                    "quantity": 1
                  }
                }
              ],
              "type": "<ontology::multiple_choice_enum.CHOOSE_ONE>"
            },
            {
              "id": "take_gold",
              "name": {
                "zh": "拿取金币",
                "en": "Take Gold"
              },
              "do_after": [
                "reserve_card"
              ],
              "<ontology::trigger>": {
                "<ontology::condition>": {
                  "zh": "<gold_supply> 中还有 <gold>（非空）。",
                  "en": "<gold_supply> still has <gold> (not empty)."
                },
                "<ontology::content>": {
                  "<ontology::instant_content>": {
                    "<ontology::transfer>": {
                      "description": {
                        "zh": "拿取金币：从 <gold_supply> 拿 1 个 <gold> 至 <player_holding>。",
                        "en": "Take gold: take 1 <gold> from <gold_supply> to <player_holding>."
                      },
                      "source": "<gold_supply>",
                      "destination": "<ontology::player_holding>",
                      "<ontology::object>": "<gold>",
                      "quantity": 1
                    }
                  }
                }
              }
            },
            {
              "do_after": [
                "reserve_card"
              ],
              "<refill_market>": {
                "description": {
                  "zh": "若为明面保留（来源 <card_market>），从对应 <development_deck> 顶部翻 1 张补入空位。",
                  "en": "If reserved openly (from <card_market>), reveal 1 card from the corresponding <development_deck> top into the empty slot."
                }
              }
            }
          ],
          "type": "<ontology::multiple_choice_enum.EXECUTE_ALL>"
        }
      }
    },
    {
      "id": "refill_market",
      "name": {
        "zh": "补牌",
        "en": "Refill Market"
      },
      "specifies": "<ontology::trigger>",
      "description": {
        "zh": "补牌 trigger：当一张 <development_card> 从 <card_market> 被移走（购买或明面保留）后，从对应等级的 <development_deck> 顶部翻 1 张补入 <card_market> 空位。",
        "en": "Refill trigger: after a <development_card> is removed from <card_market> (purchased or reserved openly), reveal 1 card from the top of the corresponding level's <development_deck> into the empty <card_market> slot."
      },
      "<ontology::condition>": {
        "zh": "被购买或保留的 <development_card> 来自 <card_market>（明面获得）。",
        "en": "The purchased or reserved <development_card> came from <card_market> (obtained openly)."
      },
      "<ontology::content>": {
        "<ontology::instant_content>": {
          "<ontology::top_draw>": {
            "description": {
              "zh": "从对应等级 <development_deck> 顶部盲抽 1 张补入 <card_market> 空位。",
              "en": "Draw 1 card blindly from the top of the corresponding level's <development_deck> into the empty <card_market> slot."
            },
            "source": "<development_deck>",
            "destination": "<card_market>",
            "<ontology::object>": "<development_card>",
            "quantity": 1
          }
        }
      }
    }
  ]
}
